<mxfile host="app.diagrams.net"><diagram name="Clases Inventario y Proveedores" id="inventario-clases"><mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;i&gt;«Servicios conecta»&lt;/i&gt;&lt;br&gt;&lt;b&gt;MenuPrincipal&lt;/b&gt;&lt;hr&gt;+ mostrar()&lt;br&gt;Scanner compartido (System.in)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#f6f6f6;dashed=1;strokeColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="300" height="78" as="geometry"/></mxCell><mxCell id="c3" value="&lt;i&gt;«vista»&lt;/i&gt;&lt;br&gt;&lt;b&gt;VistaInventario&lt;/b&gt;&lt;hr&gt;- consola: EntradaConsola&lt;br&gt;+ mostrar()&lt;br&gt;registrar / buscar / listar&lt;br&gt;consultar stock / entrada / salida&lt;br&gt;stock mínimo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="300" height="129" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i&gt;«vista»&lt;/i&gt;&lt;br&gt;&lt;b&gt;VistaProveedores&lt;/b&gt;&lt;hr&gt;- consola: EntradaConsola&lt;br&gt;+ mostrar()&lt;br&gt;registrar / buscar por ID o nombre&lt;br&gt;listar / actualizar contacto" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="320" height="112" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;«vista»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EntradaConsola&lt;/b&gt;&lt;hr&gt;+ leer / obligatorio / opcional()&lt;br&gt;+ enteroPositivo / decimalNoNegativo()&lt;br&gt;+ actualizado(etiqueta, actual)&lt;br&gt;+ ejecutar(operacion, mensaje)&lt;br&gt;nunca cierra el Scanner" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="490" y="150" width="320" height="129" as="geometry"/></mxCell><mxCell id="c6" value="&lt;i&gt;«controlador»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InventarioControlador&lt;/b&gt;&lt;hr&gt;+ registrarRepuesto(...) / buscarRepuesto(id)&lt;br&gt;+ listarRepuestos() / listarRepuestosEnStockMinimo()&lt;br&gt;+ registrarEntrada(id, n) / registrarSalida(id, n)&lt;br&gt;+ registrarProveedor(...) / buscarProveedor(id)&lt;br&gt;+ buscarProveedorPorNombre(nombre)&lt;br&gt;+ listarProveedores() / actualizarContactoProveedor(...)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="460" height="146" as="geometry"/></mxCell><mxCell id="c7" value="&lt;i&gt;«servicio»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InventarioService&lt;/b&gt;&lt;hr&gt;- repuestos: RepuestoDAO&lt;br&gt;- proveedores: ProveedorDAO&lt;br&gt;valida ids y cantidades positivas&lt;br&gt;stock nunca negativo&lt;br&gt;nombre de proveedor único" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="360" height="129" as="geometry"/></mxCell><mxCell id="c8" value="&lt;i&gt;«Servicios (Zlatan)»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ServicioService&lt;/b&gt;&lt;hr&gt;abre la transacción de negocio&lt;br&gt;usa InventarioServiciosPort&lt;br&gt;(integración pendiente)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#f6f6f6;dashed=1;strokeColor=#8a8a8a;" vertex="1" parent="1"><mxGeometry x="700" y="620" width="280" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;i&gt;«interfaz · servicio.taller.integracion»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InventarioServiciosPort&lt;/b&gt;&lt;hr&gt;+ reservar(ReservaRepuesto)&lt;br&gt;+ consumir(ConsumoRepuesto)&lt;br&gt;+ liberar(ReservaRepuesto)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#f3f8fc;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="1040" y="620" width="280" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;i&gt;«servicio»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InventarioServiciosJdbc&lt;/b&gt;&lt;hr&gt;- conexion: Connection (de Servicios)&lt;br&gt;+ reservar / consumir / liberar&lt;br&gt;+ liberarTodo(servicioId): int&lt;br&gt;+ ejecutarEnTransaccion(fuente, operacion)&lt;br&gt;no hace commit, rollback ni close" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="420" height="129" as="geometry"/></mxCell><mxCell id="c11" value="&lt;i&gt;«dao»&lt;/i&gt;&lt;br&gt;&lt;b&gt;RepuestoDAO&lt;/b&gt;&lt;hr&gt;+ listar() / buscarPorId(id)&lt;br&gt;+ registrar(repuesto)&lt;br&gt;+ registrarEntrada / registrarSalida&lt;br&gt;+ sumarStock(con, id, n)&lt;br&gt;+ restarStock(con, id, n)&lt;br&gt;+ bloquearParaActualizar(con, id)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="330" y="1030" width="330" height="146" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i&gt;«dao»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ProveedorDAO&lt;/b&gt;&lt;hr&gt;+ listar() / buscarPorId(id)&lt;br&gt;+ buscarPorNombre(nombre)&lt;br&gt;+ registrar(p)&lt;br&gt;+ actualizarContacto(p)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="280" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;i&gt;«dao»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Transaccion&lt;/b&gt;&lt;hr&gt;+ ejecutar(fuente, trabajo)&lt;br&gt;commit o rollback completo&lt;br&gt;conserva la excepción original" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="690" y="1030" width="280" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;i&gt;«dao · servicios_repuestos»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ReservaRepuestoDAO&lt;/b&gt;&lt;hr&gt;+ sumarReserva / consumir / liberar&lt;br&gt;+ buscar / buscarParaActualizar&lt;br&gt;+ listarPorServicio(con, servicioId)&lt;br&gt;UPDATE condicionados (saldo &amp;gt;= n)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="1000" y="1030" width="320" height="112" as="geometry"/></mxCell><mxCell id="c15" value="&lt;i&gt;«interfaz»&lt;/i&gt;&lt;br&gt;&lt;b&gt;FuenteConexion&lt;/b&gt;&lt;hr&gt;+ obtener(): Connection&lt;br&gt;la usan RepuestoDAO y ProveedorDAO&lt;br&gt;por defecto: ConexionFactory" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#f3f8fc;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="690" y="1230" width="280" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;i&gt;«modelo · record»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Repuesto&lt;/b&gt;&lt;hr&gt;id, nombre, marca, repuestoTipoId&lt;br&gt;precioVenta, cantidadStock, stockMinimo&lt;br&gt;+ estaEnStockMinimo()" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="330" y="1230" width="330" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;i&gt;«modelo · record»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Proveedor&lt;/b&gt;&lt;hr&gt;id, nombre (único)&lt;br&gt;personaContacto, telefono, email" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="20" y="1230" width="280" height="78" as="geometry"/></mxCell><mxCell id="c18" value="&lt;i&gt;«record · servicio.taller.integracion»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ReservaRepuesto / ConsumoRepuesto&lt;/b&gt;&lt;hr&gt;servicioId, repuestoId, cantidad &amp;gt; 0" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#f3f8fc;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="1000" y="1230" width="320" height="61" as="geometry"/></mxCell><mxCell id="c19" value="&lt;i&gt;«dao»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Excepciones de stock&lt;/b&gt;&lt;hr&gt;StockInsuficienteException&lt;br&gt;RepuestoNoEncontradoException" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#3b5872;" vertex="1" parent="1"><mxGeometry x="1000" y="1330" width="320" height="78" as="geometry"/></mxCell><mxCell id="e0" value="crea con el Scanner" style="endArrow=open;dashed=1;html=1;strokeColor=#3b5872;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#3b5872;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#3b5872;" edge="1